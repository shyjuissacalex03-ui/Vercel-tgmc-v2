rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shyjuissacalex03@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Admins metadata
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Dynamic Site Content & Assets (Public read, Authenticated write for content management)
    match /siteContent/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Prayer Requests Collection
    match /prayerRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(requestId)
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() >= 5 && incoming().email.size() <= 150
        && incoming().message is string && incoming().message.size() >= 5 && incoming().message.size() <= 3000
        && incoming().status in ['pending', 'prayed']
        && (!('userId' in incoming()) || incoming().userId == null || (isSignedIn() && incoming().userId == request.auth.uid));
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Contact Messages Collection
    match /contactMessages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(messageId)
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() >= 5 && incoming().email.size() <= 150
        && incoming().message is string && incoming().message.size() >= 5 && incoming().message.size() <= 3000
        && incoming().status in ['unread', 'read', 'replied']
        && (!('userId' in incoming()) || incoming().userId == null || (isSignedIn() && incoming().userId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    // Event RSVPs Collection
    match /eventRsvps/{rsvpId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(rsvpId)
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() >= 5 && incoming().email.size() <= 150
        && incoming().eventTitle is string && incoming().eventTitle.size() <= 200
        && (!('userId' in incoming()) || incoming().userId == null || (isSignedIn() && incoming().userId == request.auth.uid));
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && incoming().userId == userId
        && incoming().email is string && incoming().email.size() <= 150;
      allow delete: if isAdmin();
    }
  }
}
